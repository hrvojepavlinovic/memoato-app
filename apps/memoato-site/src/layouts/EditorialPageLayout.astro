---
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  description?: string;
  canonicalPath: string;
  eyebrow: string;
  heading: string;
  deck?: string;
  accent?: "sage" | "rust" | "ink";
  wide?: boolean;
  ogType?: "website" | "article";
  ogImagePath?: string;
  ogImageAlt?: string;
};

const {
  title,
  description,
  canonicalPath,
  eyebrow,
  heading,
  deck,
  accent = "sage",
  wide = false,
  ogType = "website",
  ogImagePath,
  ogImageAlt,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType={ogType}
  ogImagePath={ogImagePath}
  ogImageAlt={ogImageAlt}
  bodyClass={`editorial-page editorial-${accent}`}
>
  <slot name="head" slot="head" />

  <section class="editorial-hero">
    <div class:list={["editorial-frame", { "editorial-frame-wide": wide }]}>
      <div class="editorial-hero-grid">
        <h1>{heading}</h1>
        {ogType === "article" || ["/privacy", "/terms"].includes(canonicalPath) ? <p class="editorial-meta">{eyebrow}</p> : null}
        {deck ? <p class="editorial-deck">{deck}</p> : null}
      </div>
    </div>
  </section>

  <section class="editorial-body">
    <div class:list={["editorial-frame", "editorial-body-grid", { "editorial-frame-wide": wide }]}>
      <article class:list={["editorial-prose", { "editorial-prose-wide": wide }]}>
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
