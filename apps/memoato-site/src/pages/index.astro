---
import BaseLayout from "../layouts/BaseLayout.astro";
import MemoryExamples from "../components/MemoryExamples.astro";

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "memoato",
  operatingSystem: "Web",
  applicationCategory: "LifestyleApplication",
  url: "https://app.memoato.com",
  description: "Personal memory and source-backed context for AI-assisted work.",
  publisher: { "@id": "https://memoato.com/#organization" },
  isAccessibleForFree: true,
};
const softwareJsonLdString = JSON.stringify(softwareJsonLd);
---

<BaseLayout
  title="memoato — personal memory and context for AI"
  description="Remember the details of your life and keep project knowledge connected to its sources. Personal memory and a context pilot for AI-assisted work, in one Memoato."
  canonicalPath="/"
  bodyClass="landing-v2"
>
  <script slot="head" type="application/ld+json" set:html={softwareJsonLdString} />

  <div class="landing-shell">
    <section class="memo-hero" aria-labelledby="hero-title">
      <div class="landing-container">
        <div class="memo-hero-intro">
          <h1 id="hero-title"><span>Memory for life.</span><span>Context for AI.</span></h1>
          <p class="hero-intro">Keep the details of your day and the knowledge behind your work. Original sources stay connected to what Memoato remembers.</p>
        </div>
        <div class="memo-entry-paths">
          <article class="memo-entry" id="personal-memory" aria-labelledby="personal-title">
            <h2 id="personal-title">Personal memory</h2>
            <p>Capture the details of your day. Find them later, with the original note.</p>
            <a class="memo-button memo-button-primary" href="https://app.memoato.com" rel="noreferrer" referrerpolicy="no-referrer">
              Start remembering
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
            </a>
            <span class="memo-entry-status">Personal app · Free while we’re early</span>
          </article>
          <article class="memo-entry" aria-labelledby="ai-title">
            <h2 id="ai-title">AI &amp; team context</h2>
            <p>Keep project knowledge grounded in sources. Give AI context you can check.</p>
            <a class="memo-button memo-button-primary" href="#ai-context">
              Explore AI context
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
            </a>
            <span class="memo-entry-status">Context pilot · Read-only sources</span>
          </article>
        </div>
      </div>
    </section>

    <MemoryExamples />

    <section class="principles-section" aria-labelledby="principles-title">
      <div class="landing-container">
        <div class="principles-intro">
          <p class="eyebrow eyebrow-light"><span></span> Made for humans</p>
          <h2 id="principles-title">Quiet technology.<br />Your life stays in focus.</h2>
        </div>
        <div class="principles-grid">
          <article>
            <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M5 14.5 11 20l12-13"></path></svg>
            <h3>Raw note first</h3>
            <p>Your exact words are saved before anything else happens. The source never gets polished away.</p>
          </article>
          <article>
            <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M14 3v22M3 14h22"></path></svg>
            <h3>Helpful, not demanding</h3>
            <p>Memoato asks only when a missing detail truly matters. Everything else can wait.</p>
          </article>
          <article>
            <svg viewBox="0 0 28 28" aria-hidden="true"><rect x="5" y="4" width="18" height="20" rx="9"></rect><path d="M10 14h8"></path></svg>
            <h3>Yours to correct</h3>
            <p>Assumptions are visible and easy to change. Your corrections make future logging feel more natural.</p>
          </article>
        </div>
        <div class="quiet-tech">
          <span>Log from the web today</span>
          <i></i>
          <span>Connect Codex or Claude through MCP</span>
          <i></i>
          <span>Open source core</span>
        </div>
      </div>
    </section>

    <section class="closing-section" aria-labelledby="closing-title">
      <div class="landing-container closing-inner">
        <p class="closing-kicker">Do not track more.</p>
        <h2 id="closing-title">Remember the<br />missing context.</h2>
        <p>Start with one sentence about today.</p>
        <a
          class="memo-button memo-button-light"
          href="https://app.memoato.com"
          rel="noreferrer"
          referrerpolicy="no-referrer"
        >
          Open Memoato
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 6l4 4-4 4"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>

  <style is:global>
    .landing-v2 {
      --paper: #f4f0e7;
      --paper-deep: #e9e2d5;
      --ink: #1d201b;
      --soft-ink: #5f6259;
      --sage: #87937b;
      --forest: #26372f;
      --rust: #b75e3b;
      --blue: #637a87;
      background: var(--paper);
      color: var(--ink);
      font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
    }

    .landing-v2 .landing-shell {
      overflow: hidden;
      background: var(--paper);
    }

    .landing-v2 .landing-container {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .landing-v2 .topbar {
      background: rgba(244, 240, 231, 0.9);
      border-color: rgba(29, 32, 27, 0.12);
      box-shadow: none;
      backdrop-filter: blur(18px);
    }

    .landing-v2 .topbar-inner {
      max-width: 1180px;
      padding-top: 1.15rem;
      padding-bottom: 1.15rem;
    }

    .landing-v2 .brand {
      font-family: "Newsreader", Georgia, serif;
      font-size: 1.35rem;
      font-weight: 500;
    }

    .landing-v2 .logo {
      width: 30px;
      height: 30px;
    }

    .landing-v2 .navlinks {
      gap: 0.2rem;
    }

    .landing-v2 .navlinks .btn,
    .landing-v2 .header-actions .icon-btn {
      background: transparent;
      color: var(--soft-ink);
      font-size: 0.82rem;
      font-weight: 500;
    }

    .landing-v2 .header-actions > .btn.primary {
      min-height: 38px;
      padding-inline: 1.15rem;
      border-radius: 999px;
      background: var(--ink);
      font-size: 0.82rem;
      font-weight: 500;
    }

    .memo-hero {
      padding: 4rem 0 3.5rem;
      border-bottom: 1px solid rgba(29, 32, 27, 0.12);
    }

    .memo-hero-intro {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }

    .memo-hero h1 span { display: block; }

    .memo-entry-paths {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
      margin-top: 3rem;
    }

    .memo-entry {
      min-width: 0;
      border-top: 1px solid rgba(29, 32, 27, 0.25);
      padding-top: 1.4rem;
      scroll-margin-top: 6rem;
    }

    .memo-entry h2 {
      margin: 0;
      font-family: "Newsreader", Georgia, serif;
      font-size: 2.2rem;
      font-weight: 400;
      letter-spacing: -0.025em;
      line-height: 1.15;
    }

    .memo-entry p {
      max-width: 42ch;
      min-height: 3.3em;
      margin: 0.75rem 0 1.25rem;
      color: var(--soft-ink);
      font-size: 1.0625rem;
      line-height: 1.65;
    }

    .memo-entry-status {
      display: block;
      margin-top: 0.65rem;
      color: var(--soft-ink);
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin: 0 0 1.6rem;
      color: #6b6f64;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .eyebrow > span {
      width: 30px;
      height: 1px;
      background: currentColor;
    }

    .eyebrow-light {
      color: rgba(244, 240, 231, 0.58);
    }

    .memo-hero h1,
    .principles-intro h2,
    .closing-inner h2 {
      margin: 0;
      font-family: "Newsreader", Georgia, serif;
      font-weight: 400;
      letter-spacing: -0.035em;
    }

    .memo-hero h1 {
      font-size: clamp(3rem, 6.7vw, 5.75rem);
      line-height: 1.03;
    }

    .hero-intro {
      max-width: 39ch;
      margin: 0 0 0.25rem;
      color: var(--soft-ink);
      font-size: 1.2rem;
      line-height: 1.65;
    }

    .memo-actions {
      display: flex;
      align-items: center;
      gap: 1.6rem;
      margin-top: 2.25rem;
    }

    .memo-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      min-height: 54px;
      padding: 0.9rem 1.5rem;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      transition: transform 180ms ease, background 180ms ease, color 180ms ease;
    }

    .memo-button:hover {
      transform: translateY(-2px);
      text-decoration: none !important;
    }

    .memo-button svg {
      width: 19px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .memo-button-primary {
      background: var(--ink);
      color: white;
    }

    .memo-button-primary:hover {
      background: var(--forest);
    }

    .landing-shell :is(a, summary):focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 5px;
    }

    .principles-intro h2 {
      font-size: clamp(3.2rem, 5.5vw, 5.8rem);
      line-height: 0.97;
    }

    .principles-section {
      padding: 10rem 0 8rem;
      background: #1c211d;
      color: var(--paper);
    }

    .principles-intro {
      display: flex;
      justify-content: space-between;
      gap: 4rem;
      align-items: flex-end;
      margin-bottom: 5rem;
    }

    .principles-intro .eyebrow {
      align-self: flex-start;
      white-space: nowrap;
    }

    .principles-intro h2 {
      max-width: 740px;
      text-align: right;
    }

    .principles-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid rgba(244, 240, 231, 0.18);
      border-bottom: 1px solid rgba(244, 240, 231, 0.18);
    }

    .principles-grid article {
      padding: 3rem 2.4rem 3.4rem;
    }

    .principles-grid article + article {
      border-left: 1px solid rgba(244, 240, 231, 0.18);
    }

    .principles-grid svg {
      width: 28px;
      margin-bottom: 3.8rem;
      fill: none;
      stroke: #a8b8a1;
      stroke-width: 1.3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .principles-grid h3 {
      margin: 0 0 0.8rem;
      font-family: "Newsreader", Georgia, serif;
      font-size: 1.7rem;
      font-weight: 400;
    }

    .principles-grid p {
      margin: 0;
      color: rgba(244, 240, 231, 0.58);
      font-size: 0.86rem;
      line-height: 1.7;
    }

    .quiet-tech {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1.3rem;
      padding-top: 2.5rem;
      color: rgba(244, 240, 231, 0.46);
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .quiet-tech i {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: rgba(244, 240, 231, 0.35);
    }

    .closing-section {
      position: relative;
      padding: 11rem 0;
      background: var(--rust);
      color: white;
      text-align: center;
    }

    .closing-section::before,
    .closing-section::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      width: 1px;
      background: rgba(255, 255, 255, 0.18);
    }

    .closing-section::before { left: calc(50% - 300px); }
    .closing-section::after { right: calc(50% - 300px); }

    .closing-inner {
      position: relative;
      z-index: 1;
    }

    .closing-kicker {
      margin: 0 0 1.7rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .closing-inner h2 {
      font-size: clamp(4.5rem, 9vw, 9rem);
      line-height: 0.83;
    }

    .closing-inner > p:not(.closing-kicker) {
      margin: 2rem 0 1.7rem;
      color: rgba(255, 255, 255, 0.75);
      font-family: "Newsreader", Georgia, serif;
      font-size: 1.15rem;
      font-style: italic;
    }

    .memo-button-light {
      background: white;
      color: var(--rust);
    }

    .memo-button-light:hover {
      background: var(--ink);
      color: white;
    }

    .landing-v2 .footer {
      padding: 5rem 0;
      border-top: 0;
      background: #141714;
      color: rgba(244, 240, 231, 0.65);
    }

    .landing-v2 .footer-grid {
      max-width: 1180px;
    }

    .landing-v2 .footer .brand,
    .landing-v2 .footer a {
      color: var(--paper);
    }

    .landing-v2 .footer .btn,
    .landing-v2 .footer .icon-btn {
      border: 1px solid rgba(244, 240, 231, 0.16);
      background: transparent;
      color: var(--paper);
    }

    @media (max-width: 760px) {
      .landing-v2 .landing-container {
        width: min(100% - 2.4rem, 1180px);
      }

      .memo-hero { padding: 2.5rem 0 3rem; }
      .memo-hero-intro { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
      .memo-hero h1 { font-size: clamp(2.6rem, 10vw, 4.5rem); }
      .hero-intro { font-size: 1.0625rem; max-width: 45ch; }
      .memo-entry-paths { grid-template-columns: minmax(0, 1fr); gap: 2rem; margin-top: 2rem; }
      .memo-entry { padding-top: 1.25rem; }
      .memo-entry h2 { font-size: 1.9rem; }
      .memo-entry p { min-height: 0; font-size: 1rem; margin-bottom: 1rem; }
      .memo-entry-status { font-size: 0.875rem; }

    }

  </style>
</BaseLayout>
