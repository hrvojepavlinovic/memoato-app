---
import BaseLayout from "../layouts/BaseLayout.astro";

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "memoato",
  operatingSystem: "Web",
  applicationCategory: "LifestyleApplication",
  url: "https://app.memoato.com",
  description: "Personal memory and source-backed context for AI-assisted work.",
  publisher: { "@id": "https://memoato.com/#organization" },
  isAccessibleForFree: true,
};
const softwareJsonLdString = JSON.stringify(softwareJsonLd);
---

<BaseLayout
  title="memoato — personal memory and context for AI"
  description="Remember the details of your life and keep project knowledge connected to its sources. Personal memory and a context pilot for AI-assisted work, in one Memoato."
  canonicalPath="/"
  bodyClass="landing-v2"
>
  <script slot="head" type="application/ld+json" set:html={softwareJsonLdString} />

  <div class="landing-shell">
    <section class="memo-hero" aria-labelledby="hero-title">
      <div class="landing-container">
        <div class="memo-hero-intro">
          <h1 id="hero-title"><span>Memory for life.</span><span>Context for AI.</span></h1>
          <p class="hero-intro">Keep the details of your day and the knowledge behind your work. Original sources stay connected to what Memoato remembers.</p>
        </div>
        <div class="memo-entry-paths">
          <article class="memo-entry" id="personal-memory" aria-labelledby="personal-title">
            <h2 id="personal-title">Personal memory</h2>
            <p>Capture the details of your day. Find them later, with the original note.</p>
            <a class="memo-button memo-button-primary" href="https://app.memoato.com" rel="noreferrer" referrerpolicy="no-referrer">
              Start remembering
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
            </a>
            <span class="memo-entry-status">Personal app · Free while we’re early</span>
          </article>
          <article class="memo-entry" aria-labelledby="ai-title">
            <h2 id="ai-title">AI &amp; team context</h2>
            <p>Keep project knowledge grounded in sources. Give AI context you can check.</p>
            <a class="memo-button memo-button-primary" href="#ai-context">
              Explore AI context
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg>
            </a>
            <span class="memo-entry-status">Context pilot · Read-only sources</span>
          </article>
        </div>
      </div>
    </section>

    <section class="missing-context" id="ai-context" aria-labelledby="context-title">
      <div class="landing-container context-grid">
        <div class="section-heading context-heading">
          <h2 id="context-title">Context you<br />can check.</h2>
          <p class="context-intro">Connect project sources, review what should be remembered, and retrieve context with links back to the evidence.</p>
          <p class="context-pilot">The AI &amp; team context workflow is in pilot: one owner per workspace, with read-only GitHub and Linear sources.</p>
          <div class="context-actions">
            <a class="memo-button memo-button-light" href="mailto:hello@memoato.com?subject=Memoato%20Context%20pilot">Ask about the pilot<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"></path></svg></a>
            <a href="https://guide.hills-lab.hr" target="_blank" rel="noopener noreferrer">Read the approach</a>
          </div>
        </div>
        <div class="context-list">
          <div class="context-row">
            <div>
              <h3>Bring the source.</h3>
              <p>GitHub and Linear stay read-only. Source versions remain linked to the claims drawn from them.</p>
            </div>
          </div>
          <div class="context-row">
            <div>
              <h3>Review what’s remembered.</h3>
              <p>A person accepts or rejects a claim before it becomes part of a context packet.</p>
            </div>
          </div>
          <div class="context-row">
            <div>
              <h3>Retrieve what’s relevant.</h3>
              <p>Source permissions and freshness are checked before context is ranked for an AI tool.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="how-section" id="how-it-works" aria-labelledby="how-title">
      <div class="landing-container">
        <div class="section-heading how-heading">
          <p class="eyebrow"><span></span> Almost no ceremony</p>
          <h2 id="how-title">Write less.<br />Remember more.</h2>
          <p>Memoato is built around the way memories actually arrive: unfinished, out of order, and in your own words.</p>
        </div>

        <div class="chapter-grid">
          <article class="chapter chapter-write">
            <div class="chapter-index">I</div>
            <div class="chapter-art write-art" aria-hidden="true">
              <div class="writing-line">Bought the good coffee from that tiny place near the station.</div>
              <span class="cursor-line"></span>
            </div>
            <h3>Say it naturally</h3>
            <p>No forms to fill before the thought disappears. A sentence, a number, or a messy note is enough.</p>
          </article>

          <article class="chapter chapter-keep">
            <div class="chapter-index">II</div>
            <div class="chapter-art keep-art" aria-hidden="true">
              <span class="kept-word word-one">coffee</span>
              <span class="kept-word word-two">near the station</span>
              <span class="kept-word word-three">worth returning</span>
              <span class="kept-line line-one"></span>
              <span class="kept-line line-two"></span>
            </div>
            <h3>Keep the meaning</h3>
            <p>Your note stays whole while useful details become easy to browse, connect, and correct.</p>
          </article>

          <article class="chapter chapter-return">
            <div class="chapter-index">III</div>
            <div class="chapter-art return-art" aria-hidden="true">
              <p>“What was that coffee place I liked near the station?”</p>
              <div class="return-answer">
                <span>Found in your memory</span>
                <strong>April 17 · evening</strong>
              </div>
            </div>
            <h3>Return when it matters</h3>
            <p>Find the detail later, notice a pattern over time, or simply remember the texture of a season.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="recall-section" aria-labelledby="recall-title">
      <div class="landing-container recall-grid">
        <div class="recall-copy">
          <p class="eyebrow"><span></span> Memory becomes useful</p>
          <h2 id="recall-title">The questions only your life can answer.</h2>
          <p>
            A single note is a detail. A trail of them becomes perspective — on your energy,
            routines, health, family, work, and everything that never fit neatly in a tracker.
          </p>
          <a class="memo-text-link dark-link" href="/blog/why-memoato">Why we built Memoato <span>→</span></a>
        </div>
        <div class="question-stack">
          <div class="question-card question-card-one">
            <span>TRAINING & ENERGY</span>
            <p>What usually happens before my low-energy days?</p>
          </div>
          <div class="question-card question-card-two">
            <span>PEOPLE & PLACES</span>
            <p>Where did we have that quiet lunch by the sea?</p>
          </div>
          <div class="question-card question-card-three">
            <span>LIFE ADMIN</span>
            <p>When did I replace the car battery, and how long is the warranty?</p>
          </div>
        </div>
      </div>
    </section>

    <section class="principles-section" aria-labelledby="principles-title">
      <div class="landing-container">
        <div class="principles-intro">
          <p class="eyebrow eyebrow-light"><span></span> Made for humans</p>
          <h2 id="principles-title">Quiet technology.<br />Your life stays in focus.</h2>
        </div>
        <div class="principles-grid">
          <article>
            <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M5 14.5 11 20l12-13"></path></svg>
            <h3>Raw note first</h3>
            <p>Your exact words are saved before anything else happens. The source never gets polished away.</p>
          </article>
          <article>
            <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M14 3v22M3 14h22"></path></svg>
            <h3>Helpful, not demanding</h3>
            <p>Memoato asks only when a missing detail truly matters. Everything else can wait.</p>
          </article>
          <article>
            <svg viewBox="0 0 28 28" aria-hidden="true"><rect x="5" y="4" width="18" height="20" rx="9"></rect><path d="M10 14h8"></path></svg>
            <h3>Yours to correct</h3>
            <p>Assumptions are visible and easy to change. Your corrections make future logging feel more natural.</p>
          </article>
        </div>
        <div class="quiet-tech">
          <span>Log from the web today</span>
          <i></i>
          <span>Connect Codex or Claude through MCP</span>
          <i></i>
          <span>Open source core</span>
        </div>
      </div>
    </section>

    <section class="closing-section" aria-labelledby="closing-title">
      <div class="landing-container closing-inner">
        <p class="closing-kicker">Do not track more.</p>
        <h2 id="closing-title">Remember the<br />missing context.</h2>
        <p>Start with one sentence about today.</p>
        <a
          class="memo-button memo-button-light"
          href="https://app.memoato.com"
          rel="noreferrer"
          referrerpolicy="no-referrer"
        >
          Open Memoato
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 6l4 4-4 4"></path>
          </svg>
        </a>
      </div>
    </section>
  </div>

  <style is:global>
    .landing-v2 {
      --paper: #f4f0e7;
      --paper-deep: #e9e2d5;
      --ink: #1d201b;
      --soft-ink: #5f6259;
      --sage: #87937b;
      --forest: #26372f;
      --rust: #b75e3b;
      --blue: #637a87;
      background: var(--paper);
      color: var(--ink);
      font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
    }

    .landing-v2 .landing-shell {
      overflow: hidden;
      background: var(--paper);
    }

    .landing-v2 .landing-container {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .landing-v2 .topbar {
      background: rgba(244, 240, 231, 0.9);
      border-color: rgba(29, 32, 27, 0.12);
      box-shadow: none;
      backdrop-filter: blur(18px);
    }

    .landing-v2 .topbar-inner {
      max-width: 1180px;
      padding-top: 1.15rem;
      padding-bottom: 1.15rem;
    }

    .landing-v2 .brand {
      font-family: "Newsreader", Georgia, serif;
      font-size: 1.35rem;
      font-weight: 500;
    }

    .landing-v2 .logo {
      width: 30px;
      height: 30px;
    }

    .landing-v2 .navlinks {
      gap: 0.2rem;
    }

    .landing-v2 .navlinks .btn,
    .landing-v2 .header-actions .icon-btn {
      background: transparent;
      color: var(--soft-ink);
      font-size: 0.82rem;
      font-weight: 500;
    }

    .landing-v2 .header-actions > .btn.primary {
      min-height: 38px;
      padding-inline: 1.15rem;
      border-radius: 999px;
      background: var(--ink);
      font-size: 0.82rem;
      font-weight: 500;
    }

    .memo-hero {
      padding: 4rem 0 3.5rem;
      border-bottom: 1px solid rgba(29, 32, 27, 0.12);
    }

    .memo-hero-intro {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }

    .memo-hero h1 span { display: block; }

    .memo-entry-paths {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
      margin-top: 3rem;
    }

    .memo-entry {
      min-width: 0;
      border-top: 1px solid rgba(29, 32, 27, 0.25);
      padding-top: 1.4rem;
      scroll-margin-top: 6rem;
    }

    .memo-entry h2 {
      margin: 0;
      font-family: "Newsreader", Georgia, serif;
      font-size: 2.2rem;
      font-weight: 400;
      letter-spacing: -0.025em;
      line-height: 1.15;
    }

    .memo-entry p {
      max-width: 42ch;
      min-height: 3.3em;
      margin: 0.75rem 0 1.25rem;
      color: var(--soft-ink);
      font-size: 1.0625rem;
      line-height: 1.65;
    }

    .memo-entry-status {
      display: block;
      margin-top: 0.65rem;
      color: var(--soft-ink);
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin: 0 0 1.6rem;
      color: #6b6f64;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .eyebrow > span {
      width: 30px;
      height: 1px;
      background: currentColor;
    }

    .eyebrow-light {
      color: rgba(244, 240, 231, 0.58);
    }

    .memo-hero h1,
    .section-heading h2,
    .principles-intro h2,
    .closing-inner h2 {
      margin: 0;
      font-family: "Newsreader", Georgia, serif;
      font-weight: 400;
      letter-spacing: -0.035em;
    }

    .memo-hero h1 {
      font-size: clamp(3rem, 6.7vw, 5.75rem);
      line-height: 1.03;
    }

    .hero-intro {
      max-width: 39ch;
      margin: 0 0 0.25rem;
      color: var(--soft-ink);
      font-size: 1.2rem;
      line-height: 1.65;
    }

    .memo-actions {
      display: flex;
      align-items: center;
      gap: 1.6rem;
      margin-top: 2.25rem;
    }

    .memo-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      min-height: 54px;
      padding: 0.9rem 1.5rem;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      transition: transform 180ms ease, background 180ms ease, color 180ms ease;
    }

    .memo-button:hover {
      transform: translateY(-2px);
      text-decoration: none !important;
    }

    .memo-button svg {
      width: 19px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .memo-button-primary {
      background: var(--ink);
      color: white;
    }

    .memo-button-primary:hover {
      background: var(--forest);
    }

    .memo-text-link {
      display: inline-flex;
      gap: 0.55rem;
      align-items: center;
      padding: 0.7rem 0;
      border-bottom: 1px solid rgba(29, 32, 27, 0.3);
      color: var(--ink);
      font-size: 0.88rem;
      font-weight: 600;
    }

    .memo-text-link:hover {
      border-color: var(--ink);
      text-decoration: none !important;
    }

    .missing-context {
      padding: 6rem 0;
      scroll-margin-top: 4rem;
      background: var(--forest);
      color: var(--paper);
    }

    .context-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
      align-items: start;
    }

    .section-heading h2,
    .principles-intro h2 {
      font-size: clamp(3.2rem, 5.5vw, 5.8rem);
      line-height: 0.97;
    }

    .context-heading {
      position: sticky;
      top: 9rem;
    }

    .context-heading h2 em {
      color: #a8b8a1;
      font-weight: 400;
    }


    .context-intro {
      margin: 1.5rem 0 0;
      max-width: 44ch;
      color: #dce0d7;
      font-size: 1.125rem;
      line-height: 1.65;
    }
    .context-pilot {
      max-width: 48ch;
      margin: 1.25rem 0 0;
      color: #c8cec3;
      font-size: 1rem;
      line-height: 1.6;
    }
    .context-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.25rem;
      margin-top: 1.5rem;
    }
    .context-actions .memo-button-light {
      color: var(--forest);
    }
    .context-actions .memo-button-light:hover {
      color: white;
    }
    .context-actions > a:not(.memo-button) {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
    .landing-shell :is(a, summary):focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 5px;
    }

    .context-list {
      border-top: 1px solid rgba(244, 240, 231, 0.2);
    }

    .context-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      padding: 2rem 0;
      border-bottom: 1px solid rgba(244, 240, 231, 0.2);
    }

    .context-number {
      padding-top: 0.3rem;
      color: rgba(244, 240, 231, 0.4);
      font-family: "Newsreader", Georgia, serif;
      font-size: 0.85rem;
    }

    .context-row h3 {
      margin: 0 0 0.8rem;
      font-family: "Newsreader", Georgia, serif;
      font-size: clamp(1.5rem, 2.2vw, 2rem);
      font-weight: 400;
    }

    .context-row p {
      max-width: 530px;
      margin: 0;
      color: #c8cec3;
      font-size: 1.0625rem;
      line-height: 1.7;
    }

    .how-section {
      padding: 10rem 0 11rem;
    }

    .how-heading {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 4rem;
      margin-bottom: 5rem;
    }

    .how-heading .eyebrow {
      grid-column: 1 / -1;
      margin-bottom: -1.3rem;
    }

    .how-heading p:last-child {
      max-width: 470px;
      margin: 0 0 0.5rem auto;
      color: var(--soft-ink);
      line-height: 1.75;
    }

    .chapter-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-top: 1px solid rgba(29, 32, 27, 0.18);
      border-bottom: 1px solid rgba(29, 32, 27, 0.18);
    }

    .chapter {
      position: relative;
      min-width: 0;
      padding: 2.2rem 2rem 2.8rem;
    }

    .chapter + .chapter {
      border-left: 1px solid rgba(29, 32, 27, 0.18);
    }

    .chapter-index {
      margin-bottom: 2rem;
      color: #888b81;
      font-family: "Newsreader", Georgia, serif;
      font-size: 0.8rem;
      font-style: italic;
    }

    .chapter-art {
      height: 240px;
      margin-bottom: 2.2rem;
      overflow: hidden;
      background: #e9e2d5;
    }

    .write-art {
      position: relative;
      padding: 2rem 1.7rem;
      background-image: linear-gradient(rgba(29, 32, 27, 0.08) 1px, transparent 1px);
      background-size: 100% 32px;
    }

    .writing-line {
      color: #393a35;
      font-family: "Newsreader", Georgia, serif;
      font-size: 1.23rem;
      line-height: 1.58;
      transform: rotate(-1deg);
    }

    .cursor-line {
      display: inline-block;
      width: 1px;
      height: 20px;
      margin: 0.3rem 0 0 0.1rem;
      background: var(--rust);
    }

    .keep-art {
      position: relative;
      background: #dfe2d7;
    }

    .kept-word {
      position: absolute;
      z-index: 2;
      padding: 0.5rem 0.7rem;
      border: 1px solid rgba(38, 55, 47, 0.17);
      background: rgba(255, 255, 255, 0.62);
      color: #405047;
      font-family: "Newsreader", Georgia, serif;
      font-size: 0.82rem;
    }

    .word-one { left: 22px; top: 34px; }
    .word-two { right: 20px; top: 98px; }
    .word-three { left: 44px; bottom: 26px; }

    .kept-line {
      position: absolute;
      height: 1px;
      background: rgba(38, 55, 47, 0.22);
      transform-origin: left;
    }

    .line-one { width: 110px; left: 85px; top: 78px; transform: rotate(24deg); }
    .line-two { width: 125px; left: 120px; top: 160px; transform: rotate(-20deg); }

    .return-art {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.7rem;
      background: #d9d0c0;
    }

    .return-art > p {
      margin: 0;
      font-family: "Newsreader", Georgia, serif;
      font-size: 1.15rem;
      line-height: 1.45;
    }

    .return-answer {
      padding-top: 1rem;
      border-top: 1px solid rgba(29, 32, 27, 0.16);
    }

    .return-answer span,
    .return-answer strong {
      display: block;
    }

    .return-answer span {
      margin-bottom: 0.35rem;
      color: #77796f;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .return-answer strong {
      font-size: 0.8rem;
      font-weight: 600;
    }

    .chapter h3 {
      margin: 0 0 0.8rem;
      font-family: "Newsreader", Georgia, serif;
      font-size: 1.7rem;
      font-weight: 400;
    }

    .chapter > p {
      margin: 0;
      color: var(--soft-ink);
      font-size: 0.88rem;
      line-height: 1.7;
    }

    .recall-section {
      padding: 11rem 0;
      background: #d9d0c0;
    }

    .recall-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 9rem;
      align-items: center;
    }

    .recall-copy h2 {
      margin: 0;
      font-family: "Newsreader", Georgia, serif;
      font-size: clamp(3.2rem, 5vw, 5.3rem);
      font-weight: 400;
      letter-spacing: -0.05em;
      line-height: 0.98;
    }

    .recall-copy > p:not(.eyebrow) {
      max-width: 480px;
      margin: 2rem 0 1.6rem;
      color: #5c5b54;
      font-size: 0.94rem;
      line-height: 1.75;
    }

    .dark-link {
      color: var(--ink);
    }

    .question-stack {
      position: relative;
      min-height: 520px;
    }

    .question-card {
      position: absolute;
      width: min(100%, 430px);
      padding: 2rem 2.1rem;
      border: 1px solid rgba(29, 32, 27, 0.12);
      background: #fbf9f3;
      box-shadow: 0 28px 65px rgba(45, 38, 29, 0.1);
    }

    .question-card span {
      color: #8b8c83;
      font-size: 0.58rem;
      font-weight: 600;
      letter-spacing: 0.12em;
    }

    .question-card p {
      margin: 1.3rem 0 0;
      font-family: "Newsreader", Georgia, serif;
      font-size: 1.45rem;
      line-height: 1.3;
    }

    .question-card-one { top: 0; left: 0; transform: rotate(-2deg); }
    .question-card-two { top: 150px; right: 0; transform: rotate(2.5deg); }
    .question-card-three { bottom: 0; left: 28px; transform: rotate(-0.8deg); }

    .principles-section {
      padding: 10rem 0 8rem;
      background: #1c211d;
      color: var(--paper);
    }

    .principles-intro {
